{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "The apex-linux Renovate preset. Every input is pinned: actions by commit SHA, container images by digest, release binaries by SHA-256, crates by Cargo.lock.",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":dependencyDashboard"
  ],
  "timezone": "Etc/UTC",
  "labels": [
    "dependencies"
  ],
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "description": "Rust crates: minor and patch updates in one PR, once a week.",
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "cargo minor and patch",
      "schedule": [
        "* 0-5 * * 1"
      ]
    },
    {
      "description": "GitHub Actions: full commit SHAs with the version as a comment, once a week.",
      "matchManagers": [
        "github-actions"
      ],
      "pinDigests": true,
      "groupName": "github actions",
      "schedule": [
        "* 0-5 * * 1"
      ]
    },
    {
      "description": "Container images are always referenced by digest.",
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": true
    },
    {
      "description": "Fedora images never jump to the next release; major upgrades follow the manual runbook (ADR 0008).",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "registry.fedoraproject.org/fedora",
        "registry.fedoraproject.org/fedora-bootc"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "enabled": false
    },
    {
      "description": "Fedora 45 image digests (the image's ARG BASE and ARG REPOS_BASE and the CI containers) move together, daily, with no release-age wait: Fedora is the trusted root and rebuilds these tags daily. The pins live on registry.fedoraproject.org, which keeps old digests.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "registry.fedoraproject.org/fedora",
        "registry.fedoraproject.org/fedora-bootc"
      ],
      "matchUpdateTypes": [
        "digest",
        "pinDigest"
      ],
      "groupName": "fedora 45 images",
      "minimumReleaseAge": "0 days",
      "schedule": [
        "* 0-5 * * *"
      ]
    },
    {
      "description": "Pinned release binaries in install-tool.sh: version and SHA-256 move together.",
      "matchManagers": [
        "custom.regex"
      ],
      "groupName": "ci tool binaries",
      "schedule": [
        "* 0-5 * * 1"
      ],
      "matchFileNames": [
        "**/install-tool.sh"
      ]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "VERSION and SHA256 pairs after a '# renovate:' comment in install-tool.sh.",
      "managerFilePatterns": [
        "/(^|/)install-tool\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n[A-Z_]+_VERSION=(?<currentValue>\\S+)\\n[A-Z_]+_SHA256=(?<currentDigest>[a-f0-9]{64})"
      ]
    }
  ]
}
